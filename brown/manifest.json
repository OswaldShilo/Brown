{
  "manifest_version": 3,
  "name": "Brown",
  "version": "0.1.0",
  "description": "Annotates Claude responses with sketch-style highlights, margin notes, and diagrams.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/main.tsx"]
    }
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "128": "public/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["public/pets/yuan/spritesheet.webp"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
